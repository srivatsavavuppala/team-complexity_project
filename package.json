{
  "name": "ai-recruitment-helper",
  "version": "1.0.0",
  "description": "Enterprise AI-Powered Interview & Recruitment Helper",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "dev-python": "concurrently \"npm run python-server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "python-server": "cd server_python && python main.py",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "install-all": "npm install && cd server && npm install && cd ../client && npm install",
    "install-python": "cd server_python && pip install -r requirements.txt && cd ../client && npm install",
    "test": "cd server && npm test && cd ../client && npm test",
    "docker-up": "docker-compose up -d",
    "docker-up-python": "docker-compose -f docker-compose-python.yml up -d",
    "docker-down": "docker-compose down",
    "docker-down-python": "docker-compose -f docker-compose-python.yml down"
  },
  "keywords": ["AI", "recruitment", "interview", "groq", "enterprise"],
  "author": "AI Recruitment Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}